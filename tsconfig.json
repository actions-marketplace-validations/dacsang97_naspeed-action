{
  "compilerOptions": {
    "esModuleInterop": true,
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "newLine": "lf",
    "outDir": "./lib",
    "rootDir": ".",
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src", "__tests__"]
}
